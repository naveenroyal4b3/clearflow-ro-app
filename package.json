{
  "name": "clearflow-ro",
  "version": "1.1.0",
  "private": true,
  "description": "Clearflow RO sales and service app",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
