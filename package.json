    "e2e": "playwright test",
    "lint": "eslint ."
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@supabase/supabase-js": "^2.57.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
